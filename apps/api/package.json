{
  "name": "@nexquiz/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=@nexquiz/source --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.4.0",
    "@fastify/static": "^10.1.5",
    "@nexquiz/shared": "0.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "music-metadata": "^12.0.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  }
}
