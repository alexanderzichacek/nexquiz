{
  "name": "nexquiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w packages/shared && npm run build -w apps/web && npm run build -w apps/api",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w apps/api && npm run typecheck -w apps/web && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate -w apps/api --",
    "db:migrate": "npm run db:migrate -w apps/api --",
    "smoke": "tsx --conditions=@nexquiz/source scripts/smoke.ts",
    "loadtest": "tsx --conditions=@nexquiz/source scripts/loadtest.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "sodium-native": "npm:sodium-javascript@^0.8.0"
  }
}
